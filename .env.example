# --- LLM provider --------------------------------------------------------
# "huggingface" uses the Hugging Face Inference API (free tier).
# "groq" uses the Groq API (free tier, faster). Pick one.
LLM_PROVIDER=huggingface

# Hugging Face access token - create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Groq API key - only needed when LLM_PROVIDER=groq. Get one at https://console.groq.com
GROQ_API_KEY=

# --- Optional overrides --------------------------------------------------
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# TOP_K=4
# USE_RERANKER=false
